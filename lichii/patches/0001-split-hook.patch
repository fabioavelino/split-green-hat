diff --git a/CMakeLists.txt b/CMakeLists.txt
index 8e847462b0..c06135bf65 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -728,6 +728,17 @@ if (MSVC AND CXX_CLANG)
     link_libraries(llvm-mingw-runtime)
 endif()
 
+# Two-player split-screen (github.com/fabioavelino/split-green-hat). Off unless asked for.
+option(LICHII_SPLIT "Build in the single-instance split hook from LICHII_SPLIT_DIR" OFF)
+if (LICHII_SPLIT)
+    set(LICHII_SPLIT_DIR "" CACHE PATH "Checkout of split-green-hat")
+    if (NOT EXISTS "${LICHII_SPLIT_DIR}/split/hook/split_hook.cpp")
+        message(FATAL_ERROR "LICHII_SPLIT_DIR must point at a split-green-hat checkout")
+    endif()
+    set(SPLIT_BUILD_TESTS OFF)
+    add_subdirectory("${LICHII_SPLIT_DIR}" "${CMAKE_BINARY_DIR}/split" EXCLUDE_FROM_ALL)
+endif()
+
 add_subdirectory(src)
 
 if (ENABLE_DEBUG_TOOLS)
